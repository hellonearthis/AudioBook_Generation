  {
    "passage_id": "mccarthy_no_country",
    "title": "No Country for Old Men (Cormac McCarthy)",
    "arms": [
      {
        "arm": "Arm 1A: Pure Heuristic Rules",
        "spans": [
          {
            "type": "narrator",
            "text": "You need to put it up.",
